*.pem
*.key
*.crt
*.p12
*.pfx
.env
.env.*
!.env.example

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store

# Generated development secrets (docs/dev/compose.md)
.dev-secrets/
