{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sakuraops.example/schemas/sakura-task-v1.schema.json",
  "title": "Sakura Task v1 (draft)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "steps"
  ],
  "properties": {
    "apiVersion": {
      "const": "sakuraops/v1"
    },
    "kind": {
      "const": "Task"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,62}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    "inputs": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]{0,62}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/input"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "$defs": {
    "scalar": {
      "oneOf": [
        {
          "type": "string",
          "maxLength": 4096
        },
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "scalarArray": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/scalar"
      }
    },
    "inputRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input"
      ],
      "properties": {
        "input": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,62}$"
        }
      }
    },
    "outputRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output"
      ],
      "properties": {
        "output": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "step",
            "field"
          ],
          "properties": {
            "step": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,62}$"
            },
            "field": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,62}$"
            }
          }
        }
      }
    },
    "value": {
      "oneOf": [
        {
          "$ref": "#/$defs/scalar"
        },
        {
          "$ref": "#/$defs/scalarArray"
        },
        {
          "$ref": "#/$defs/inputRef"
        },
        {
          "$ref": "#/$defs/outputRef"
        }
      ]
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "label"
      ],
      "properties": {
        "type": {
          "enum": [
            "string",
            "integer",
            "boolean",
            "string_list"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "default": {
          "oneOf": [
            {
              "$ref": "#/$defs/scalar"
            },
            {
              "$ref": "#/$defs/scalarArray"
            }
          ]
        },
        "enum": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/scalar"
          }
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "action",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,62}$"
        },
        "action": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
          "maxLength": 128
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "with": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_-]{0,62}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/value"
          }
        },
        "when": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "left",
            "op",
            "right"
          ],
          "properties": {
            "left": {
              "oneOf": [
                {
                  "$ref": "#/$defs/inputRef"
                },
                {
                  "$ref": "#/$defs/outputRef"
                }
              ]
            },
            "op": {
              "enum": [
                "eq",
                "ne",
                "gt",
                "gte",
                "lt",
                "lte"
              ]
            },
            "right": {
              "$ref": "#/$defs/scalar"
            }
          }
        }
      }
    }
  }
}
