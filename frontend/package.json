{
	"name": "sakuraops-frontend",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.17.0"
	},
	"scripts": {
		"prepare": "svelte-kit sync",
		"dev": "vite dev",
		"build": "vite build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --threshold warning",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.4.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.2",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"svelte": "^5.59.2",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"vite": "^8.4.0",
		"vitest": "^5.1.2"
	},
	"dependencies": {
		"@codemirror/lang-yaml": "^6.1.3",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.44.2",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/xterm": "^6.0.0",
		"codemirror": "^6.0.2"
	}
}
